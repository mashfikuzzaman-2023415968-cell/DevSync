# DevSync environment (spec §6.1). Copy with `make env`, which fills every secret
# with strong random values. Never commit `.env`. Values here are safe dev defaults.

# --- Environment -------------------------------------------------------------
# development | test | production (production refuses insecure settings at startup)
DEVSYNC_ENV=development
LOG_LEVEL=INFO

# --- Secrets (generated by `make env`) --------------------------------------
# >= 64 random bytes, base64. Signs tokens; derives the TOTP encryption key.
SECRET_KEY=
# ALTCHA CAPTCHA challenge signing key (spec §14.16).
CAPTCHA_HMAC_KEY=
# Database passwords: superuser (init only) and the least-privilege roles.
POSTGRES_PASSWORD=
DEVSYNC_MIGRATOR_PASSWORD=
DEVSYNC_APP_PASSWORD=
DEVSYNC_WORKER_PASSWORD=
DEVSYNC_READONLY_PASSWORD=
# Redis requires a password in every environment.
REDIS_PASSWORD=

# --- Origin and hosts ---------------------------------------------------------
# Used for CSRF Origin checks, email links and redirects. Must be https in production.
PUBLIC_ORIGIN=https://localhost
# Comma-separated Host header allowlist (TrustedHost). Never '*'.
ALLOWED_HOSTS=localhost,api
# Client IP is taken from X-Forwarded-For only when the peer is in this range (Nginx).
TRUSTED_PROXY_IPS=172.16.0.0/12
HTTP_PORT=80
HTTPS_PORT=443

# --- Sessions (spec §14.4: 15-minute tokens, rotated, up to 7 days) ---------
SESSION_ROTATE_MINUTES=15
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=168

# --- Email / SMS ------------------------------------------------------------
# Mailpit in development (web UI on http://127.0.0.1:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=DevSync <no-reply@devsync.local>
# `console` prints OTPs to the log and is refused outside development.
SMS_PROVIDER=console

# --- Integrations (optional) -------------------------------------------------
# Read-only GitHub token; pass privately, never through git.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
JUDGE0_URL=http://judge0:2358
JUDGE0_AUTH_TOKEN=
# Optional Nginx allowlist for admin routes, e.g. 10.0.0.0/8 (empty = allow all).
ADMIN_ALLOWED_CIDRS=

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20

# --- Workers, pools, timeouts ----------------------------------------------
# 0 = 2 x CPU + 1. Dev overlay uses 2 to stay within laptop memory.
GUNICORN_WORKERS=0
GUNICORN_TIMEOUT=30
MAX_REQUESTS=1000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000
CACHE_TTL_SECONDS_DEFAULT=60
